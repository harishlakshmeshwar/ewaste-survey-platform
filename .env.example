# Copy this file to `.env` and fill in values. Never commit `.env`.

# --- Server ---
NODE_ENV=development
PORT=3001

# Data source: appsscript | sheets | local | none
# none     → API serves empty states until a source is configured
DATA_SOURCE=none

# --- Option A: Google Apps Script web app (recommended) ---
# Deploy the doGet() script in docs/GOOGLE-INTEGRATION.md as a web app,
# then paste its /exec URL here.
# APPS_SCRIPT_URL=

# --- Option B: Google Sheets published via API key ---
# Publish the response sheet: Share → "Anyone with the link" → Viewer.
# GOOGLE_SHEETS_ID=
# GOOGLE_API_KEY=
# GOOGLE_SHEET_GID=0

# --- Option C: local CSV/JSON export ---
# LOCAL_DATA_FILE=data/sample-responses.csv

# Survey links shown on the Participate page (public responder URL is safe to expose;
# never put the form EDITOR URL in the repo or in the frontend)
# SURVEY_URL=https://docs.google.com/forms/d/e/1FAIpQLSdFyISogxtArX9oaHMIF03mPneXghtCVjg7-obfVS7nUsiXfg/viewform
# SURVEY_EMBED_URL=https://docs.google.com/forms/d/e/1FAIpQLSdFyISogxtArX9oaHMIF03mPneXghtCVjg7-obfVS7nUsiXfg/viewform?embedded=true

# Admin token (min 8 chars) gates /api/admin/* and /api/env-issues.
# Required in production for diagnostics.
# ADMIN_TOKEN=

# Cache for upstream fetches (seconds)
CACHE_TTL_SECONDS=300

# Demo data visibility:
#   auto   → demo only when explicitly requested (?demo=1), clearly labelled
#   always → demo shown even without real data (never in production)
#   never  → demo disabled
DEMO_MODE=auto
